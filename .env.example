# Les mêmes clés se renseignent dans le projet Vercel, pour Production et Preview.
# Sur Vercel, prends la chaîne pooled (l'hôte contient -pooler).
# Neon Postgres — onglet Connection details, chaîne avec sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# Compte créé par npm run db:seed. Ce gardien technique ne peut pas être verrouillé dehors.
ADMIN_USERNAME=gardien
ADMIN_PASSWORD=
ADMIN_NAME=Gardien des archives

# Neon Object Storage — la branche doit être en AWS us-east-2
# Console → branche → Storage : crée un bucket privé nommé gaelia
# Puis une credential avec storage:read et storage:write
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=gaelia
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=
